# Reference values for the production deployment. Set these on the hosting
# platform for the Backend service — this file is not read by the app
# directly (see .env.example for local development).
APP_ENV=production
SERVICE_NAME=football-odds-service
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=https://football-odds-service.projectsin.ai
PUBLIC_API_URL=https://api.football-odds-service.projectsin.ai
